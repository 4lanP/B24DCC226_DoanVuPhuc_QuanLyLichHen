<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.QuanLyLichHen" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_50</item>
        <item name="colorOnPrimaryContainer">@color/teal_700</item>
        <item name="colorSecondary">@color/teal_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorOnSurfaceVariant">@color/ink_600</item>
        <item name="colorOutline">@color/ink_300</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Tắt lớp phủ màu theo độ cao của Material 3: thẻ giữ đúng màu trắng,
             tương phản rõ với nền xám nhạt. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Ứng dụng vẽ tràn ra sau thanh trạng thái (edge-to-edge).
             Màu hai thanh để trong suốt, màu icon do từng Activity quyết định. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.QuanLyLichHen" parent="Base.Theme.QuanLyLichHen" />

    <!-- Tiêu đề lớn ở đầu màn hình -->
    <style name="TextAppearance.QuanLyLichHen.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chữ phụ, mô tả -->
    <style name="TextAppearance.QuanLyLichHen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_600</item>
    </style>

    <!-- Nhãn của một nhóm nhập liệu trong thẻ form -->
    <style name="TextAppearance.QuanLyLichHen.Label" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
